  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.9490196, g: 0.92941177, b: 0.98039216, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 17
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.12
  m_Text: "\uB370\uC2A4\uD06C\uD1B1\uC5D0\uC11C\uB294 \uC218\uC9C1 \uB3D9\uAE30\uD654\uAC00
    \uCF1C\uC9C0\uBA74 \uD654\uBA74 \uC8FC\uC0AC\uC728\uC774 \uC6B0\uC120\uD558\uBA70
    FPS \uC81C\uD55C\uC740 \uBB34\uC2DC\uB429\uB2C8\uB2E4.\n\uBC84\uD2BC\uC744 \uB20C\uB7EC
    \uC9C0\uC6D0\uB418\uB294 \uAC12\uC744 \uC21C\uD658\uD569\uB2C8\uB2E4. \uD654\uBA74
    \uBCC0\uACBD\uC740 \uC801\uC6A9 \uD6C4 15\uCD08 \uD655\uC778\uC774 \uD544\uC694\uD569\uB2C8\uB2E4.\n\uC774
    \uC2E4\uD589 \uD658\uACBD\uC5D0\uC11C\uB294 \uD654\uBA74 \uD574\uC0C1\uB3C4/\uBAA8\uB4DC
    \uBCC0\uACBD\uC744 \uC81C\uACF5\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uD14C\uC2A4\uD2B8
    \uBE4C\uB4DC\uC5D0\uC11C \uD655\uC778\uD558\uC138\uC694."
