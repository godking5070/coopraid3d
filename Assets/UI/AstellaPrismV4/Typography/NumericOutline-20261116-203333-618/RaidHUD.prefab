--- !u!114 &7597084635822331524
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5283866829701078089}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.9490196, g: 0.92941177, b: 0.98039216, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 14
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.12
  m_Text: "<b>[\uC5ED\uD560 \uD2B9\uC9D5]</b> \uBCF4\uC2A4 \uC5B4\uADF8\uB85C 1\uC21C\uC704
    \uACE0\uC815! 2\uD398\uC774\uC988 \uC904(Tether)\uC740 <b>\uADFC\uB51C AI \uBD07\uC774
    \uB300\uC2E0 \uAC00\uB85C\uCC44 \uC0DD\uC874\uAE30\uB85C \uB098\uB97C \uC9C0\uCF1C\uC90D\uB2C8\uB2E4!</b>\n\n\u2022
    <b>[1] \uBC29\uD328 \uAC15\uD0C0 3\uB2E8 (GCD):</b>\n  \uBC29\uD328 \uAC00\uACA9(100)
    \u2192 \uD68C\uC804 \uBCA0\uAE30(180+\uC5B4\uADF8\uB85C) \u2192 \uB300\uC9C0
    \uBD84\uC1C4(300+<b>\uB0B4 \uCCB4\uB825 15% \uC790\uD790</b>)\n\u2022 <b>[2]
    \uC2EC\uD310\uC758 \uD22C\uCC3D 3\uB2E8 (GCD):</b>\n  \uC911\uAC70\uB9AC \uCC3D/\uBC29\uD328
    \uD22C\uCC99 \uBCF4\uC2A4 \uC8FC\uCC28 \uC720\uB3C4 & \uC131\uAD11 \uBCF4\uD638\uB9C9\n\u2022
    <b>[3] \uCCA0\uBCBD \uBC29\uC5B4 (oGCD, \uCFE8 12\uCD08):</b>\n  4\uCD08\uAC04
    \uBC1B\uB294 \uBAA8\uB4E0 \uD53C\uD574 <b>60% \uAC10\uC18C</b> (\uD0F1\uD06C\uBC84\uC2A4\uD130
    \uBC29\uC5B4)\n\u2022 <b>[Q] \uB3C4\uBC1C \uBC0F \uC904 \uAC15\uD0C8 (oGCD, \uCFE8
    15\uCD08):</b>\n  \uC5B4\uADF8\uB85C \uCD5C\uC6B0\uC120 \uACE0\uC815 + \uC544\uAD70\uC758
    \uC904(Tether) \uC989\uC2DC \uAC15\uD0C8!"
