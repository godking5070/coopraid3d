  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RaidRogue.LocalShortcutText
  _template: "<b>[\uC5ED\uD560 \uD2B9\uC9D5]</b> \uC2A4\uD0AC \uD56B\uBC14 \uC704
    <b>\uC804\uC6A9 \uCE90\uC2A4\uD305 \uBC14</b> \uBCF4\uC720! \uCE90\uC2A4\uD305
    \uB3C4\uC911 W/A/S/D \uC774\uB3D9 \uC2DC \uC2DC\uC804\uC774 \uCDE8\uC18C(<b>CAST
    INTERRUPTED!</b>)\uB429\uB2C8\uB2E4.\n\n\u2022 <b>[1] \uD654\uC5FC \uD3ED\uD48D
    3\uB2E8 \uCE90\uC2A4\uD305 (GCD - \uB9D0\uB69D \uB51C):</b>\n  1\uB2E8 \uD30C\uC774\uC5B4(1.2s,
    200) \u2192 2\uB2E8 \uD30C\uC774\uAC00(1.5s, 380) \u2192 <b>3\uB2E8 \uD50C\uB808\uC5B4(2.0s,
    750 \uCD08\uACE0\uD654\uB825 \uD3ED\uBC1C!)</b>\n\u2022 <b>[2] \uB0C9\uAE30 \uD30C\uB3D9
    3\uB2E8 (GCD - \uBB34\uBE59\uC0F7):</b>\n  \uCE90\uC2A4\uD305 \uC5C6\uC774 <b>\uC774\uB3D9\uD558\uBA74\uC11C
    \uC989\uC2DC \uBC1C\uC0AC</b>(100\u2192150\u2192220, \uC7A5\uD310 \uD68C\uD53C\uC6A9)\n\u2022
    <b>[3] \uB9C8\uB098 \uBC30\uB9AC\uC5B4 (oGCD, \uCFE8 15\uCD08):</b>\n  4\uCD08\uAC04
    \uD53C\uD574 70% \uAC10\uC18C + \uD53C\uACA9 \uC2DC \uC2DC\uC804 \uB04A\uAE40
    \uBA74\uC5ED + \uBCF4\uD638\uB9C9\n\u2022 <b>[Q] \uC0BC\uC5F0\uC18D \uB9C8\uBC95
    (oGCD, \uCFE8 25\uCD08):</b>\n  <b>6\uCD08 \uB3D9\uC548 [1]\uBC88 \uD654\uC5FC
    \uCE90\uC2A4\uD305 \uCF64\uBCF4\uAC00 \uCE90\uC2A4\uD305 0\uCD08(\uC989\uBC1C
    \uBB34\uBE59\uC0F7!)</b>\uB85C \uBC1C\uB3D9!"
