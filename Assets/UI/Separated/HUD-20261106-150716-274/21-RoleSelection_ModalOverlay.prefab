--- !u!114 &2108904211118120255
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8019432653239339014}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.90588236, g: 0.91764706, b: 0.9372549, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 14
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.12
  m_Text: "<b>[\uC5ED\uD560 \uD2B9\uC9D5]</b> \uBCF4\uC2A4\uC758 \uCE21\uBA74(45~135\xB0)\uACFC
    \uD6C4\uBA74(135~180\xB0)\uC744 \uB178\uB824 \uD06C\uB9AC\uD2F0\uCEEC \uC624\uC758\uB97C
    \uAF42\uC544 \uB123\uB294 \uAE30\uB3D9\uD615 \uADFC\uC811 \uB51C\uB7EC!\n\n\u2022
    <b>[1] \uCE21\uBA74 3\uB2E8 \uC9C4\uD654 \uCF64\uBCF4 (GCD):</b>\n  \uC12C\uAD11
    \uBCA0\uAE30(100) \u2192 \uC9C8\uD48D(250) \u2192 <b>\uCD5C\uC885 \uC624\uC758:
    \uCE21\uBA74 \uC77C\uC12C(450!)</b>\n\u2022 <b>[2] \uD6C4\uBA74 3\uB2E8 \uC9C4\uD654
    \uCF64\uBCF4 (GCD):</b>\n  \uADF8\uB9BC\uC790 \uBCA0\uAE30(100) \u2192 \uC554\uC2B5(250)
    \u2192 <b>\uCD5C\uC885 \uC624\uC758: \uC2EC\uC7A5 \uC801\uCD9C(450!)</b>\n\u2022
    <b>[3] \uAC1C\uC778 \uC0DD\uC874\uAE30 (oGCD, \uCFE8 15\uCD08):</b>\n  3\uCD08\uAC04
    \uBC1B\uB294 \uD53C\uD574 <b>80% \uAC10\uC18C</b> (\uC904 \uAC00\uB85C\uCC44\uAE30
    \uBC29\uC5B4 \uD575\uC2EC)\n\u2022 <b>[Q] \uC9C8\uD48D \uCC0C\uB974\uAE30 (oGCD,
    \uCFE8 8\uCD08):</b>\n  \uAE00\uCFE8(GCD) \uB3C4\uC911 \uC989\uC2DC \uB07C\uC6CC\uB123\uB294
    \uACE0\uC18D \uAD00\uD1B5 \uCD94\uAC00 \uD0C0\uACA9(180)!"
