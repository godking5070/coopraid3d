  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.92, g: 0.95, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 14
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.15
  m_Text: "<b>[\uC5ED\uD560 \uD2B9\uC9D5]</b> \uCCB4\uB825 \uBE44\uC728\uC774 \uAC00\uC7A5
    \uB0AE\uC740 \uC544\uAD70\uC744 \uC790\uB3D9\uC73C\uB85C \uC6B0\uC120 \uD0C0\uAC9F\uD558\uB294
    \uC2A4\uB9C8\uD2B8 \uD790\uB7EC!\n\n\u2022 <b>[1] \uC2EC\uD310\uC758 \uBE5B 3\uB2E8
    (GCD):</b>\n  \uBE5B\uC758 \uD0C4\uD658(120) \u2192 \uB2E8\uC8C4\uC758 \uBE5B(200)
    \u2192 \uCC9C\uBC8C\uC758 \uAE30\uB465(350 \uC6D0\uAC70\uB9AC \uB9C8\uBC95 \uB51C)\n\u2022
    <b>[2] \uAD6C\uC6D0\uC758 \uCE58\uC720 & \uBCF4\uD638\uB9C9 (GCD):</b>\n  \uCD5C\uC800
    \uCCB4\uB825 \uC544\uAD70 <b>HP 40% \uC989\uC2DC \uD68C\uBCF5 + \uCD5C\uB300
    \uCCB4\uB825 20% \uB178\uB780 \uBCF4\uD638\uB9C9(Shield)</b> \uBD80\uC5EC\n\u2022
    <b>[3] \uCE58\uC720\uC758 \uC131\uC5ED (oGCD, \uCFE8 15\uCD08):</b>\n  \uB0B4
    \uBC1C\uBC11\uC5D0 6\uCD08\uAC04 \uC720\uC9C0\uB418\uB294 <b>\uCD08\uB85D\uC0C9
    \uAD11\uC5ED \uD790 \uC7A5\uD310</b> \uC124\uCE58\n\u2022 <b>[Q] \uAD6C\uCD9C
    - Rescue (oGCD, \uCFE8 20\uCD08):</b>\n  \uC704\uD5D8 \uC7A5\uD310 \uC548\uC758
    \uC544\uAD70 \uBD07\uC744 \uB0B4 \uC704\uCE58\uB85C \uB04C\uC5B4\uB2F9\uAE30\uBA70
    <b>3\uCD08\uAC04 \uBB34\uC801/\uC774\uC18D \uBC84\uD504</b> \uBD80\uC5EC!"
