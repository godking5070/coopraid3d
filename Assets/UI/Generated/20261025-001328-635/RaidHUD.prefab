  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 14
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.2
  m_Text: "<b>[Project: Raid Rogue - Step 9 (STAGE 1/3 | \uB0B4 \uC9C1\uC5C5: <color=#FFEE44>3.\uBE14\uB808\uC774\uB4DC(\uADFC\uB51C)</color>
    [P] | \uBDF0: <color=#FFEE55>3D \uCFFC\uD130\uBDF0</color> [F12])]</b>\n\u2022
    <b>\uD0C0\uAC9F\uD305</b> : <b>[\uB9C8\uC6B0\uC2A4 \uC88C\uD074\uB9AD]</b> \uC720\uB2DB/UI
    \uC120\uD0DD | <b>[F1 / F2 / F3 / F4]</b> \uD30C\uD2F0\uC6D0 1~4\uBC88 | <b>[TAB]</b>
    \uC801(\uBCF4\uC2A4\xB7\uCAC4) \uC21C\uD658 | <b>[T]</b> \uB300\uC0C1\uC758 \uB300\uC0C1
    | <b>[BKSP]</b> \uD0C0\uAC9F \uD574\uC81C | <b>[ESC]</b> \uCC3D \uB2EB\uAE30
    / \uBA54\uB274\n\u2022 <b>\uC774\uB3D9/\uCE74\uBA54\uB77C</b> : W/A/S/D \uCE74\uBA54\uB77C
    \uAE30\uC900 \uC774\uB3D9 \xB7 \uC6B0\uD074\uB9AD \uB4DC\uB798\uADF8 \uD68C\uC804
    \xB7 \uD720 \uC90C \xB7 SPACE \uB300\uC26C \xB7 X \uD3EC\uC158 \xB7 5 \uC774\uB9AC\uC2A4
    \uCF54\uC778(\uC0AC\uB9DD \uC544\uAD70 \uC120\uD0DD) | [F10] \uC124\uC815\n--------------------------------------------------------------------------------\n\u2022
    <b>\uB0B4 \uCCB4\uB825</b> : <b>1000 / 1000</b>   |   <b>\uD604\uC7AC \uD0C0\uAC9F</b>
    : <color=#FFEE55>[BOSS] STAGE 1 : \uACF5\uD5C8\uC758 \uD30C\uC218\uAFBC</color>\n\u2022
    <b>\uB0B4 \uAC01\uB3C4 (XZ)</b> : <b>180.0\xB0</b> [<color=#55CCFF>\uD6C4\uBA74
    (Rear)</color>]   |   <b>\uCD5C\uADFC \uC804\uD22C \uB85C\uADF8</b> : \uB300\uAE30
    \uC911 ([1] \uCE21\uBA74 3\uB2E8 \uCF64\uBCF4 / [2] \uD6C4\uBA74 3\uB2E8 \uCF64\uBCF4)\n\u2022
    <b>\uB204\uC801 \uCE74\uB4DC \uBE4C\uB4DC</b> : <color=#FFE066>\uC5C6\uC74C (\uBCF4\uC2A4
    \uCC98\uCE58 \uC2DC \uCE74\uB4DC 3\uD0DD \uBCF4\uC0C1 \uC9C0\uAE09!)</color>"
